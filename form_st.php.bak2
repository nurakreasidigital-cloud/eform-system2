            <div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('submitModalST')">Batal</button><button class="btn btn-success" onclick="executeKirimST()">📤 Kirim</button></div>
        </div>
    </div>

    <script>
    var STORAGE_KEY_ST = 'formST_draft';
    var STATUS_KEY_ST = 'formST_status';
    var photosST = [];
    var statusST = 'draft';
    var lockedST = false;
    var submittedST = false;
    var pelaksanaCount = 1;
    var dasarCount = <?= count($defaultDasar) ?>;

    // ===== LOAD DRAFT =====
    function loadDraftST() {
        try {
            var saved = localStorage.getItem(STORAGE_KEY_ST);
            if (saved) {
                var data = JSON.parse(saved);
                // Isi field biasa
                for (var key in data) {
                    if (key === 'photos') { photosST = data.photos || []; renderPhotosST(); continue; }
                    if (key === 'pelaksana') {
                        if (data.pelaksana && data.pelaksana.length > 0) {
                            document.getElementById('pelaksanaContainer').innerHTML = '';
                            data.pelaksana.forEach(function(p, i) {
                                tambahPelaksana(i, p.nama, p.jabatan);
                            });
                        }
                        continue;
                    }
                    if (key === 'dasar') {
                        // Jika ada data dasar di localStorage, gunakan itu
                        if (data.dasar && data.dasar.length > 0) {
                            document.getElementById('dasarContainer').innerHTML = '';
                            data.dasar.forEach(function(d, i) {
                                tambahDasar(i, d);
                            });
                        }
                        continue;
                    }
                    var el = document.getElementById(key);
                    if (el) el.value = data[key] || '';
                }
            }
        } catch(e) { console.log('Load draft error:', e); }
        
        // Status
        try {
            var st = JSON.parse(localStorage.getItem(STATUS_KEY_ST));
            if (st) { statusST = st.status || 'draft'; lockedST = st.locked || false; submittedST = st.submitted || false; }
        } catch(e) {}
        updateStatusBarST();
    }

    // ===== SAVE DRAFT =====
    function saveDraftST() {
        if (lockedST || submittedST) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var data = getAllDataST();
        data.photos = photosST;
        localStorage.setItem(STORAGE_KEY_ST, JSON.stringify(data));
        document.getElementById('statusInfo').textContent = '✅ Draf tersimpan ' + new Date().toLocaleTimeString();
        showToast('💾 Draf berhasil disimpan!', 'success');
    }

    function getAllDataST() {
        var fields = document.querySelectorAll('#formContainer input, #formContainer textarea, #formContainer select');
        var data = {};
        fields.forEach(function(el) {
            if (el.id) {
                if (el.type === 'checkbox') data[el.id] = el.checked;
                else data[el.id] = el.value;
            }
        });
        // Pelaksana
        var pelaksana = [];
        document.querySelectorAll('.pelaksana-item').forEach(function(item) {
            var nama = item.querySelector('.pelaksana_nama').value;
            var jabatan = item.querySelector('.pelaksana_jabatan').value;
            if (nama) pelaksana.push({ nama: nama, jabatan: jabatan });
        });
        data.pelaksana = pelaksana;
        // Dasar
        var dasar = [];
        document.querySelectorAll('.dasar-item').forEach(function(item) {
            var text = item.querySelector('.dasar_text').value;
            if (text) dasar.push(text);
        });
        data.dasar = dasar;
        return data;
    }

    // ===== PELAKSANA =====
    function tambahPelaksana(index, nama, jabatan) {
        var container = document.getElementById('pelaksanaContainer');
        var i = index !== undefined ? index : pelaksanaCount;
        var div = document.createElement('div');
        div.className = 'pelaksana-item';
        div.id = 'pelaksana_' + i;
        div.innerHTML = '<span class="pelaksana-num">Pelaksana ' + (i+1) + '</span><button class="remove-btn" onclick="removePelaksana(' + i + ')">✕</button><div class="grid-2"><div class="form-group"><label>Nama <span class="req">*</span></label><input type="text" class="pelaksana_nama" value="' + (nama || '') + '" placeholder="Nama pelaksana"></div><div class="form-group"><label>Jabatan</label><input type="text" class="pelaksana_jabatan" value="' + (jabatan || '') + '" placeholder="Jabatan"></div></div>';
        container.appendChild(div);
        pelaksanaCount++;
        updatePelaksanaButtons();
    }

    function removePelaksana(index) {
        var items = document.querySelectorAll('.pelaksana-item');
        if (items.length <= 1) { showToast('Minimal 1 pelaksana!', 'warning'); return; }
        var item = document.getElementById('pelaksana_' + index);
        if (item) item.remove();
        renumberPelaksana();
        updatePelaksanaButtons();
        saveDraftST();
    }

    function renumberPelaksana() {
        document.querySelectorAll('.pelaksana-item').forEach(function(el, i) {
            el.id = 'pelaksana_' + i;
            el.querySelector('.pelaksana-num').textContent = 'Pelaksana ' + (i+1);
            el.querySelector('.remove-btn').setAttribute('onclick', 'removePelaksana(' + i + ')');
        });
    }

    function updatePelaksanaButtons() {
        var items = document.querySelectorAll('.pelaksana-item');
        if (items.length <= 1) {
            document.querySelectorAll('.pelaksana-item .remove-btn').forEach(function(btn) { btn.style.display = 'none'; });
        } else {
            document.querySelectorAll('.pelaksana-item .remove-btn').forEach(function(btn) { btn.style.display = 'block'; });
        }
    }

    // ===== DASAR HUKUM =====
    function tambahDasar(index, text) {
        var container = document.getElementById('dasarContainer');
        var i = index !== undefined ? index : dasarCount;
        var div = document.createElement('div');
        div.className = 'dasar-item';
        div.innerHTML = '<span class="dasar-num">' + (i+1) + '.</span><input type="text" class="dasar_text" value="' + (text || '') + '" placeholder="Masukkan dasar hukum..." style="flex:1;padding:6px 10px;border:1px solid #DDE3F0;border-radius:6px;font-size:13px;"><button class="remove-dasar" onclick="removeDasar(this)">✕</button>';
        container.appendChild(div);
        dasarCount++;
        updateDasarButtons();
    }

    function removeDasar(btn) {
        var items = document.querySelectorAll('.dasar-item');
        if (items.length <= 1) { showToast('Minimal 1 dasar!', 'warning'); return; }
        btn.closest('.dasar-item').remove();
        renumberDasar();
        updateDasarButtons();
        saveDraftST();
    }

    function renumberDasar() {
        document.querySelectorAll('.dasar-item').forEach(function(el, i) {
            el.querySelector('.dasar-num').textContent = (i+1) + '.';
        });
    }

    function updateDasarButtons() {
        var items = document.querySelectorAll('.dasar-item');
        if (items.length <= 1) {
            document.querySelectorAll('.dasar-item .remove-dasar').forEach(function(btn) { btn.style.display = 'none'; });
        } else {
            document.querySelectorAll('.dasar-item .remove-dasar').forEach(function(btn) { btn.style.display = 'inline'; });
        }
    }

    // ===== PHOTOS =====
    function addPhotosST(e) {
        if (lockedST || submittedST) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var files = Array.from(e.target.files);
        files.forEach(function(file) {
            var reader = new FileReader();
            reader.onload = function(ev) {
                photosST.push({ src: ev.target.result, caption: '' });
                renderPhotosST();
                saveDraftST();
            };
            reader.readAsDataURL(file);
        });
        e.target.value = '';
    }

    function renderPhotosST() {
        var grid = document.getElementById('photoGridST');
        grid.innerHTML = '';
        photosST.forEach(function(p, i) {
            var div = document.createElement('div');
            div.className = 'photo-item';
            div.innerHTML = '<img src="' + p.src + '"><input class="caption-input" placeholder="Keterangan..." value="' + (p.caption || '') + '" onchange="photosST[' + i + '].caption=this.value;saveDraftST();"><button class="remove-btn" onclick="removePhotoST(' + i + ')">✕</button>';
            grid.appendChild(div);
        });
    }

    function removePhotoST(i) { if (lockedST || submittedST) { showToast('Form sudah terkunci/dikirim!', 'error'); return; } photosST.splice(i, 1); renderPhotosST(); saveDraftST(); }

    // ===== STATUS =====
    function updateStatusBarST() {
        var badge = document.getElementById('statusBadge');
        var labels = { 'draft': '📝 Draf', 'locked': '🔒 Terkunci', 'submitted': '📤 Terkirim', 'approved': '✅ Diterima', 'rejected': '❌ Ditolak' };
        badge.textContent = labels[statusST] || '📝 Draf';
        badge.className = 'status-badge ' + statusST;
        document.getElementById('statusInfo').textContent = statusST === 'draft' ? 'Data tersimpan di browser' : statusST === 'locked' ? '🔒 Form terkunci' : statusST === 'submitted' ? '📤 Menunggu validasi' : statusST === 'approved' ? '✅ Telah divalidasi' : '❌ Ditolak';
        if (statusST === 'locked' || statusST === 'submitted' || statusST === 'approved') {
            document.getElementById('formContainer').classList.add('form-disabled');
            document.getElementById('lockBtnST').disabled = true;
            document.getElementById('submitBtnST').disabled = true;
        } else {
            document.getElementById('formContainer').classList.remove('form-disabled');
            document.getElementById('lockBtnST').disabled = false;
            document.getElementById('submitBtnST').disabled = false;
        }
    }

    // ===== LOCK =====
    function confirmLockST() {
        if (lockedST || submittedST) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        document.getElementById('lockModalST').classList.add('show');
        document.getElementById('confirmCheckST').checked = false;
        document.getElementById('confirmLockBtnST').disabled = true;
    }

    document.getElementById('confirmCheckST').addEventListener('change', function() {
        document.getElementById('confirmLockBtnST').disabled = !this.checked;
    });

    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function executeLockST() {
        closeModal('lockModalST');
        lockedST = true;
        statusST = 'locked';
        localStorage.setItem(STATUS_KEY_ST, JSON.stringify({ status: statusST, locked: true, submitted: false }));
        updateStatusBarST();
        showToast('🔒 Form berhasil dikunci!', 'success');
        alert('📄 Fitur download PDF akan segera hadir.');
    }

    // ===== KIRIM =====
    function kirimKeServerST() {
        if (submittedST) { showToast('Form sudah terkirim!', 'warning'); return; }
        if (!lockedST) { showToast('⚠️ Form harus di-lock terlebih dahulu!', 'warning'); return; }
        document.getElementById('submitModalST').classList.add('show');
    }

    function executeKirimST() {
        closeModal('submitModalST');
        var data = getAllDataST();
        data.photos = photosST;
        var btn = document.getElementById('submitBtnST');
        btn.disabled = true;
        btn.textContent = '⏳ Mengirim...';
        
        fetch('api/submit_form.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ form_type: 'form_st', data: data, status: 'submitted' })
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            if (result.success) {
                submittedST = true;
                statusST = 'submitted';
                localStorage.setItem(STATUS_KEY_ST, JSON.stringify({ status: statusST, locked: true, submitted: true }));
                updateStatusBarST();
                showToast('✅ Form berhasil dikirim!', 'success');
            } else {
                showToast('❌ Gagal: ' + (result.message || 'Unknown error'), 'error');
            }
        })
        .catch(function(err) {
            showToast('❌ Gagal: ' + err.message, 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = '📤 Kirim';
        });
    }

    // ===== RESET =====
    function resetFormST() {
        if (lockedST || submittedST) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        if (!confirm('Reset semua data?')) return;
        localStorage.removeItem(STORAGE_KEY_ST);
        location.reload();
    }

    // ===== TOAST =====
    function showToast(msg, type) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:10px;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);max-width:90%;';
        var colors = { success: '#2E7D32', error: '#C62828', warning: '#F5A623', info: '#2D5BE3' };
        toast.style.background = colors[type] || '#1A1A2E';
        toast.style.color = '#fff';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
    }

    // ===== INIT =====
    document.addEventListener('DOMContentLoaded', function() {
        var today = new Date().toISOString().slice(0,10);
        ['tgl_st', 'tgl_pelaksanaan_st', 'ttd_tgl_st'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && !el.value) el.value = today;
        });
        loadDraftST();
        updatePelaksanaButtons();
        updateDasarButtons();
        // Auto save setiap 15 detik
        setInterval(function() { 
            if (!lockedST && !submittedST) { 
                var data = getAllDataST(); 
                data.photos = photosST; 
                localStorage.setItem(STORAGE_KEY_ST, JSON.stringify(data)); 
            } 
        }, 15000);
    });

    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
    </script>
</body>
</html>