<?php
require_once 'config/database.php';
require_once 'config/auth.php';
if (!canAccessForm('form_st')) {
    die("<h1>⛔ Akses Ditolak</h1><p>Anda tidak memiliki akses ke form ini.</p><a href='dashboard.php'>← Kembali</a>");
}
if (!isLoggedIn()) {
    header('Location: index.php');
    exit;
}

$stmt = $pdo->prepare("SELECT * FROM forms WHERE form_key = 'form_st'");
$stmt->execute();
$form = $stmt->fetch(PDO::FETCH_ASSOC);

// Ambil data kop dari database
$kop_logo = $form["kop_logo"] ?? "";
$kop_instansi = $form["kop_instansi"] ?? "BADAN PENGAWAS PEMILIHAN UMUM";
$kop_alamat = $form["kop_alamat"] ?? "";
$kop_telp = $form["kop_telp"] ?? "";
$kop_email = $form["kop_email"] ?? "";

if (!$form || $form['is_active'] != 1) {
    die("<h1>⚠️ Form Surat Tugas sedang tidak aktif</h1>");
}

// Default dasar hukum (8 item)
$defaultDasar = [
    'Peraturan Pemerintah Pengganti Undang-Undang Republik Indonesia Nomor 1 Tahun 2022 tentang Perubahan atas Undang-undang Nomor 7 Tahun 2017 tentang Pemilihan Umum;',
    'Peraturan Presiden Nomor 68 Tahun 2018 tentang Kedudukan Tugas, Fungsi, Wewenang, Organisasi dan Tata Kerja Sekretariat Jenderal Badan Pengawas Pemilihan Umum;',
    'Peraturan Menteri Keuangan Republik Indonesia Nomor 113/PMK.05/2012 tentang Perjalanan Dinas Dalam Negeri bagi Pejabat Negara, Pegawai Negeri dan Pegawai tidak tetap;',
    'Peraturan Menteri Keuangan Republik Indonesia Nomor 210/PMK.05/2022 tentang Tata Cara Pembayaran dalam Rangka Pelaksanaan Anggaran Pendapatan dan Belanja Negara;',
    'Peraturan Menteri Keuangan Republik Indonesia Nomor 49 Tahun 2023 tentang Standar Biaya Masukan Tahun Anggaran 2024;',
    'Peraturan Badan Pengawas Pemilihan Umum Republik Indonesia Nomor 1 Tahun 2021 tentang Organisasi dan Tata Kerja Sekretariat Jenderal Badan Pengawas Pemilihan Umum;',
    'Keputusan Ketua Badan Pengawas Pemilihan Umum Nomor 237/HK.01/K1/07/2023 tanggal 14 Juli 2023 tentang Pedoman Pelaksanaan Perjalanan Dinas Di Badan Pengawas Pemilihan Umum;',
    'Anggaran hibah Bawaslu Provinsi Jawa Tengah dan/atau anggaran hibah Bawaslu Kabupaten Cilacap;'
];
