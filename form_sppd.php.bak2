    <!-- MODAL -->
    <div class="modal-overlay" id="lockModalSPPD">
        <div class="modal-box">
            <h3>🔒 Konfirmasi Lock</h3>
            <p>Apakah semua data sudah benar?<br><small>Setelah di-lock, form tidak bisa diedit.</small></p>
            <div style="margin:12px 0;"><label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;"><input type="checkbox" id="confirmCheckSPPD"> Saya sudah memeriksa semua data</label></div>
            <div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('lockModalSPPD')">Batal</button><button class="btn btn-warning" id="confirmLockBtnSPPD" disabled onclick="executeLockSPPD()">🔒 Lock</button></div>
        </div>
    </div>

    <div class="modal-overlay" id="submitModalSPPD">
        <div class="modal-box">
            <h3>📤 Kirim ke Server</h3>
            <p>Data akan dikirim ke server untuk divalidasi.</p>
            <div style="margin:12px 0;padding:10px;background:#F8F9FC;border-radius:8px;font-size:12px;color:#6B7A99;">⚠️ Pastikan data sudah benar dan lengkap.</div>
            <div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('submitModalSPPD')">Batal</button><button class="btn btn-success" onclick="executeKirimSPPD()">📤 Kirim</button></div>
        </div>
    </div>

    <script>
    var STORAGE_KEY_SPPD = 'formSPPD_draft';
    var STATUS_KEY_SPPD = 'formSPPD_status';
    var photosSPPD = [];
    var statusSPPD = 'draft';
    var lockedSPPD = false;
    var submittedSPPD = false;

    function loadDraftSPPD() {
        try {
            var saved = localStorage.getItem(STORAGE_KEY_SPPD);
            if (saved) {
                var data = JSON.parse(saved);
                for (var key in data) {
                    if (key === 'photos') { photosSPPD = data.photos || []; renderPhotosSPPD(); continue; }
                    var el = document.getElementById(key);
                    if (el) el.value = data[key] || '';
                }
            }
        } catch(e) {}
        try {
            var st = JSON.parse(localStorage.getItem(STATUS_KEY_SPPD));
            if (st) { statusSPPD = st.status || 'draft'; lockedSPPD = st.locked || false; submittedSPPD = st.submitted || false; }
        } catch(e) {}
        updateStatusBarSPPD();
    }

    function saveDraftSPPD() {
        if (lockedSPPD || submittedSPPD) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var data = getAllDataSPPD();
        data.photos = photosSPPD;
        localStorage.setItem(STORAGE_KEY_SPPD, JSON.stringify(data));
        document.getElementById('statusInfo').textContent = '✅ Draf tersimpan ' + new Date().toLocaleTimeString();
        showToast('💾 Draf berhasil disimpan!', 'success');
    }

    function getAllDataSPPD() {
        var fields = document.querySelectorAll('#formContainer input, #formContainer textarea, #formContainer select');
        var data = {};
        fields.forEach(function(el) {
            if (el.id) {
                if (el.type === 'checkbox') data[el.id] = el.checked;
                else data[el.id] = el.value;
            }
        });
        return data;
    }

    function addPhotosSPPD(e) {
        if (lockedSPPD || submittedSPPD) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var files = Array.from(e.target.files);
        files.forEach(function(file) {
            var reader = new FileReader();
            reader.onload = function(ev) {
                photosSPPD.push({ src: ev.target.result, caption: '' });
                renderPhotosSPPD();
                saveDraftSPPD();
            };
            reader.readAsDataURL(file);
        });
        e.target.value = '';
    }

    function renderPhotosSPPD() {
        var grid = document.getElementById('photoGridSPPD');
        grid.innerHTML = '';
        photosSPPD.forEach(function(p, i) {
            var div = document.createElement('div');
            div.className = 'photo-item';
            div.innerHTML = '<img src="' + p.src + '"><input class="caption-input" placeholder="Keterangan..." value="' + (p.caption || '') + '" onchange="photosSPPD[' + i + '].caption=this.value;saveDraftSPPD();"><button class="remove-btn" onclick="removePhotoSPPD(' + i + ')">✕</button>';
            grid.appendChild(div);
        });
    }

    function removePhotoSPPD(i) { if (lockedSPPD || submittedSPPD) { showToast('Form sudah terkunci/dikirim!', 'error'); return; } photosSPPD.splice(i, 1); renderPhotosSPPD(); saveDraftSPPD(); }

    function updateStatusBarSPPD() {
        var badge = document.getElementById('statusBadge');
        var labels = { 'draft': '📝 Draf', 'locked': '🔒 Terkunci', 'submitted': '📤 Terkirim', 'approved': '✅ Diterima', 'rejected': '❌ Ditolak' };
        badge.textContent = labels[statusSPPD] || '📝 Draf';
        badge.className = 'status-badge ' + statusSPPD;
        document.getElementById('statusInfo').textContent = statusSPPD === 'draft' ? 'Data tersimpan di browser' : statusSPPD === 'locked' ? '🔒 Form terkunci' : statusSPPD === 'submitted' ? '📤 Menunggu validasi' : statusSPPD === 'approved' ? '✅ Telah divalidasi' : '❌ Ditolak';
        if (statusSPPD === 'locked' || statusSPPD === 'submitted' || statusSPPD === 'approved') {
            document.getElementById('formContainer').classList.add('form-disabled');
            document.getElementById('lockBtnSPPD').disabled = true;
            document.getElementById('submitBtnSPPD').disabled = true;
        } else {
            document.getElementById('formContainer').classList.remove('form-disabled');
            document.getElementById('lockBtnSPPD').disabled = false;
            document.getElementById('submitBtnSPPD').disabled = false;
        }
    }

    function confirmLockSPPD() {
        if (lockedSPPD || submittedSPPD) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        document.getElementById('lockModalSPPD').classList.add('show');
        document.getElementById('confirmCheckSPPD').checked = false;
        document.getElementById('confirmLockBtnSPPD').disabled = true;
    }

    document.getElementById('confirmCheckSPPD').addEventListener('change', function() {
        document.getElementById('confirmLockBtnSPPD').disabled = !this.checked;
    });

    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function executeLockSPPD() {
        closeModal('lockModalSPPD');
        lockedSPPD = true;
        statusSPPD = 'locked';
        localStorage.setItem(STATUS_KEY_SPPD, JSON.stringify({ status: statusSPPD, locked: true, submitted: false }));
        updateStatusBarSPPD();
        showToast('🔒 Form berhasil dikunci!', 'success');
        alert('📄 Fitur download PDF akan segera hadir.');
    }

    function kirimKeServerSPPD() {
        if (submittedSPPD) { showToast('Form sudah terkirim!', 'warning'); return; }
        if (!lockedSPPD) { showToast('⚠️ Form harus di-lock terlebih dahulu!', 'warning'); return; }
        document.getElementById('submitModalSPPD').classList.add('show');
    }

    function executeKirimSPPD() {
        closeModal('submitModalSPPD');
        var data = getAllDataSPPD();
        data.photos = photosSPPD;
        var btn = document.getElementById('submitBtnSPPD');
        btn.disabled = true;
        btn.textContent = '⏳ Mengirim...';
        
        fetch('api/submit_form.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ form_type: 'form_sppd', data: data, status: 'submitted' })
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            if (result.success) {
                submittedSPPD = true;
                statusSPPD = 'submitted';
                localStorage.setItem(STATUS_KEY_SPPD, JSON.stringify({ status: statusSPPD, locked: true, submitted: true }));
                updateStatusBarSPPD();
                showToast('✅ Form berhasil dikirim!', 'success');
            } else {
                showToast('❌ Gagal: ' + (result.message || 'Unknown error'), 'error');
            }
        })
        .catch(function(err) {
            showToast('❌ Gagal: ' + err.message, 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = '📤 Kirim';
        });
    }

    function resetFormSPPD() {
        if (lockedSPPD || submittedSPPD) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        if (!confirm('Reset semua data?')) return;
        localStorage.removeItem(STORAGE_KEY_SPPD);
        location.reload();
    }

    function showToast(msg, type) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:10px;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);max-width:90%;';
        var colors = { success: '#2E7D32', error: '#C62828', warning: '#F5A623', info: '#2D5BE3' };
        toast.style.background = colors[type] || '#1A1A2E';
        toast.style.color = '#fff';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function() {
        var today = new Date().toISOString().slice(0,10);
        ['tgl_sppd', 'tgl_berangkat', 'tgl_kembali', 'ttd_tgl_sppd'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && !el.value) el.value = today;
        });
        loadDraftSPPD();
        setInterval(function() { if (!lockedSPPD && !submittedSPPD) { var data = getAllDataSPPD(); data.photos = photosSPPD; localStorage.setItem(STORAGE_KEY_SPPD, JSON.stringify(data)); } }, 15000);
    });

    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
    </script>
</body>
</html>