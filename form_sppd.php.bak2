                    </div></div>

                    <!-- BUTTONS -->
                    <div class="btn-row">
                        <button class="btn btn-outline btn-sm" onclick="resetFormSPPD()">🗑 Reset</button>
                        <button class="btn btn-secondary" onclick="saveDraftSPPD()">💾 Simpan Draf</button>
                        <button class="btn btn-warning" id="lockBtnSPPD" onclick="confirmLockSPPD()">🔒 Lock & Download</button>
                        <button class="btn btn-success" id="submitBtnSPPD" onclick="kirimKeServerSPPD()">📤 Kirim</button>
