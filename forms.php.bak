        .kop-section .form-group input:focus { border-color: #E53935; outline: none; }
        .kop-logo-preview { max-width: 100px; max-height: 60px; display: block; margin-top: 4px; border: 1px solid #DDE3F0; border-radius: 4px; padding: 4px; }
