            display: flex;
            gap: 12px;
            align-items: flex-start;
        }
        .notif-item:hover { border-color: #C0C8E0; }
        .notif-item.unread {
            background: #EEF4FF;
            border-left: 4px solid #2D5BE3;
        }
        .notif-item .icon { font-size: 24px; flex-shrink: 0; }
