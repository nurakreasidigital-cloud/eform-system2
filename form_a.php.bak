            <div style="margin:12px 0;padding:10px;background:#F8F9FC;border-radius:8px;font-size:12px;color:#6B7A99;">⚠️ Pastikan data sudah benar dan lengkap.</div>
            <div class="modal-actions"><button class="btn btn-outline" onclick="closeModal('submitModal')">Batal</button><button class="btn btn-success" onclick="executeKirim()">📤 Kirim</button></div>
        </div>
    </div>

    <script>
    var STORAGE_KEY = 'formA_draft';
    var STATUS_KEY = 'formA_status';
    var photos = [];
    var status = 'draft';
    var locked = false;
    var submitted = false;

    function loadDraft() {
        try {
            var saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                var data = JSON.parse(saved);
                for (var key in data) {
                    if (key === 'photos') { photos = data.photos || []; renderPhotos(); continue; }
                    var el = document.getElementById(key);
                    if (el) el.value = data[key] || '';
                }
                if (data.ada_pelanggaran) { document.getElementById('ada_pelanggaran').checked = true; togglePelanggaran(); }
                if (data.ada_sengketa) { document.getElementById('ada_sengketa').checked = true; toggleSengketa(); }
            }
        } catch(e) {}
        try {
            var st = JSON.parse(localStorage.getItem(STATUS_KEY));
            if (st) { status = st.status || 'draft'; locked = st.locked || false; submitted = st.submitted || false; }
        } catch(e) {}
        updateStatusBar();
    }

    function saveDraft() {
        if (locked || submitted) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var data = getAllData();
        data.photos = photos;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        document.getElementById('statusInfo').textContent = '✅ Draf tersimpan ' + new Date().toLocaleTimeString();
        showToast('💾 Draf berhasil disimpan!', 'success');
    }

    function getAllData() {
        var fields = document.querySelectorAll('#formContainer input, #formContainer textarea, #formContainer select');
        var data = {};
        fields.forEach(function(el) {
            if (el.id) {
                if (el.type === 'checkbox') data[el.id] = el.checked;
                else data[el.id] = el.value;
            }
        });
        return data;
    }

    function addPhotos(e) {
        if (locked || submitted) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        var files = Array.from(e.target.files);
        files.forEach(function(file) {
            var reader = new FileReader();
            reader.onload = function(ev) {
                photos.push({ src: ev.target.result, caption: '' });
                renderPhotos();
                saveDraft();
            };
            reader.readAsDataURL(file);
        });
        e.target.value = '';
    }

    function renderPhotos() {
        var grid = document.getElementById('photoGrid');
        grid.innerHTML = '';
        photos.forEach(function(p, i) {
            var div = document.createElement('div');
            div.className = 'photo-item';
            div.innerHTML = '<img src="' + p.src + '"><input class="caption-input" placeholder="Keterangan..." value="' + (p.caption || '') + '" onchange="photos[' + i + '].caption=this.value;saveDraft();"><button class="remove-btn" onclick="removePhoto(' + i + ')">✕</button>';
            grid.appendChild(div);
        });
    }

    function removePhoto(i) { if (locked || submitted) { showToast('Form sudah terkunci/dikirim!', 'error'); return; } photos.splice(i, 1); renderPhotos(); saveDraft(); }

    function togglePelanggaran() {
        var on = document.getElementById('ada_pelanggaran').checked;
        document.getElementById('pelanggaranFields').classList.toggle('show', on);
        document.getElementById('tidakPelanggaran').style.display = on ? 'none' : 'block';
    }

    function toggleSengketa() {
        var on = document.getElementById('ada_sengketa').checked;
        document.getElementById('sengketaFields').classList.toggle('show', on);
        document.getElementById('tidakSengketa').style.display = on ? 'none' : 'block';
    }

    function updateStatusBar() {
        var badge = document.getElementById('statusBadge');
        var labels = { 'draft': '📝 Draf', 'locked': '🔒 Terkunci', 'submitted': '📤 Terkirim', 'approved': '✅ Diterima', 'rejected': '❌ Ditolak' };
        badge.textContent = labels[status] || '📝 Draf';
        badge.className = 'status-badge ' + status;
        document.getElementById('statusInfo').textContent = status === 'draft' ? 'Data tersimpan di browser' : status === 'locked' ? '🔒 Form terkunci' : status === 'submitted' ? '📤 Menunggu validasi' : status === 'approved' ? '✅ Telah divalidasi' : '❌ Ditolak';
        if (status === 'locked' || status === 'submitted' || status === 'approved') {
            document.getElementById('formContainer').classList.add('form-disabled');
            document.getElementById('lockBtn').disabled = true;
            document.getElementById('submitBtn').disabled = true;
        } else {
            document.getElementById('formContainer').classList.remove('form-disabled');
            document.getElementById('lockBtn').disabled = false;
            document.getElementById('submitBtn').disabled = false;
        }
    }

    function confirmLock() {
        if (locked || submitted) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        document.getElementById('lockModal').classList.add('show');
        document.getElementById('confirmCheck').checked = false;
        document.getElementById('confirmLockBtn').disabled = true;
    }

    document.getElementById('confirmCheck').addEventListener('change', function() {
        document.getElementById('confirmLockBtn').disabled = !this.checked;
    });

    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function executeLock() {
        closeModal('lockModal');
        locked = true;
        status = 'locked';
        localStorage.setItem(STATUS_KEY, JSON.stringify({ status: status, locked: true, submitted: false }));
        updateStatusBar();
        showToast('🔒 Form berhasil dikunci!', 'success');
        alert('📄 Fitur download PDF akan segera hadir.');
    }

    function kirimKeServer() {
        if (submitted) { showToast('Form sudah terkirim!', 'warning'); return; }
        if (!locked) { showToast('⚠️ Form harus di-lock terlebih dahulu!', 'warning'); return; }
        document.getElementById('submitModal').classList.add('show');
    }

    function executeKirim() {
        closeModal('submitModal');
        var data = getAllData();
        data.photos = photos;
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Mengirim...';
        
        fetch('api/submit_form.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ form_type: 'form_a', data: data, status: 'submitted' })
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            if (result.success) {
                submitted = true;
                status = 'submitted';
                localStorage.setItem(STATUS_KEY, JSON.stringify({ status: status, locked: true, submitted: true }));
                updateStatusBar();
                showToast('✅ Form berhasil dikirim!', 'success');
            } else {
                showToast('❌ Gagal: ' + (result.message || 'Unknown error'), 'error');
            }
        })
        .catch(function(err) {
            showToast('❌ Gagal: ' + err.message, 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = '📤 Kirim';
        });
    }

    function resetForm() {
        if (locked || submitted) { showToast('Form sudah terkunci/dikirim!', 'error'); return; }
        if (!confirm('Reset semua data?')) return;
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
    }

    function showToast(msg, type) {
        var toast = document.createElement('div');
        toast.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:12px 24px;border-radius:10px;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,0.2);max-width:90%;';
        var colors = { success: '#2E7D32', error: '#C62828', warning: '#F5A623', info: '#2D5BE3' };
        toast.style.background = colors[type] || '#1A1A2E';
        toast.style.color = '#fff';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function() {
        var today = new Date().toISOString().slice(0,10);
        ['tgl_laporan', 'tgl_kegiatan', 'ttd_tgl'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el && !el.value) el.value = today;
        });
        loadDraft();
        setInterval(function() { if (!locked && !submitted) { var data = getAllData(); data.photos = photos; localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } }, 15000);
    });

    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
    </script>
</body>
</html>
